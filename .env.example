# Create this key in the DeepSeek platform. Never commit a real key.
# 在 DeepSeek 开放平台创建；请勿将真实密钥提交到版本库。
DEEPSEEK_API_KEY=

# DeepSeek Anthropic-compatible endpoint used by the local Agent SDK runner.
# DeepSeek 官方 Anthropic 兼容接口，供本机 Claude Agent SDK 子进程使用。
DEEPSEEK_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-v4-flash

# Local Agent SDK limits. Sessions, the knowledge base, and MCP tools stay local.
# SDK 单次 Agent 循环上限；会话、知识库和 MCP 工具均在本机运行。
AGENT_MAX_TURNS=6
AGENT_CONTEXT_COMPACTION_TOKENS=60000
AGENT_TIMEOUT_SECONDS=90
AGENT_TOOL_BASE_URL=http://127.0.0.1:8000

# Local retrieval and upload limits / 本地检索与上传限制。
TOP_K=5
CHUNK_SIZE=900
CHUNK_OVERLAP=120
CHUNK_BOUNDARY_MODE=natural
PDF_CHUNK_SCOPE=page
IMAGE_INDEX_MODE=attachment_only
MINIMUM_RETRIEVAL_SCORE=0
MAX_UPLOAD_MB=15

# RainS3 object storage (optional; falls back to local filesystem).
# RainS3 对象存储 (可选; 未配置时使用本地文件系统)。
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=knowledge
S3_REGION=us-east-1

# MySQL for conversation history. For a remote database, prefer an SSH tunnel
# bound to 127.0.0.1:13306 instead of exposing MySQL to the public internet.
# MySQL 对话历史。远程数据库建议经 SSH 隧道映射到 127.0.0.1:13306，
# 不要将 MySQL 直接暴露到公网。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=kh_user
MYSQL_PASSWORD=
MYSQL_DATABASE=knowledge
